#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 2 || ! $1 =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$ ]]; then
  echo 'Usage: scripts/package-release vMAJOR.MINOR.PATCH[-prerelease] OUTPUT_DIR' >&2
  exit 2
fi
tag=$1
out=$2
commit=$(git rev-parse --verify "refs/tags/$tag^{commit}")
if [[ $commit != "$(git rev-parse HEAD)" ]]; then
  echo 'Check out the release tag before packaging.' >&2
  exit 1
fi

mkdir -p "$out"
name="glaze-scale-$tag"
git archive --format=tar --prefix="$name/" --add-virtual-file="$name/VERSION:$tag" "$commit" |
  gzip -n > "$out/$name.tar.gz"
(cd "$out" && shasum -a 256 "$name.tar.gz" > SHA256SUMS)
